<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configure Widget"
                android:textColor="@color/obsidian_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="18dp" />

            <!-- ===== NOTE SOURCE ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTE SOURCE"
                android:textColor="@color/obsidian_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <!-- Vault -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/config_vault_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No vault selected"
                    android:textColor="@color/obsidian_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/config_select_vault"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button_background"
                    android:text="Select"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <!-- Note Mode -->
            <RadioGroup
                android:id="@+id/config_note_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/config_radio_daily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_daily_note"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp"
                    android:buttonTint="@color/obsidian_primary" />

                <RadioButton
                    android:id="@+id/config_radio_pinned"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_specific_note"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp"
                    android:buttonTint="@color/obsidian_primary" />
            </RadioGroup>

            <!-- Pinned Notes -->
            <LinearLayout
                android:id="@+id/config_pinned_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/config_note_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/config_add_note"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:background="@drawable/button_outline"
                    android:text="+ Add Note"
                    android:textColor="@color/obsidian_text"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Daily Notes Folder -->
            <LinearLayout
                android:id="@+id/config_daily_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/config_daily_folder"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/daily_notes_hint"
                    android:textColor="@color/obsidian_text"
                    android:textColorHint="@color/obsidian_text_secondary"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="text"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/config_date_format"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/input_background"
                    android:text="yyyy-MM-dd"
                    android:hint="@string/date_format_label"
                    android:textColor="@color/obsidian_text"
                    android:textColorHint="@color/obsidian_text_secondary"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- ===== BEHAVIOR ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEHAVIOR"
                android:textColor="@color/obsidian_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:clipToOutline="true">

                <!-- Show buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show Add &amp; Note buttons"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_show_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Sort unchecked -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sort unchecked first"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_sort_unchecked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Tap checkbox only -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Toggle only on checkbox tap"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_tap_checkbox_only"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Show add-to-top -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show add-to-top on capture"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_show_add_to_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Show TODO count -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show TODO count in header"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_show_todo_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Hide frontmatter / properties -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hide frontmatter / properties"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Strip YAML --- blocks from view"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_hide_frontmatter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Start preview after first heading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start after first heading"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skip content before first # heading"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_start_after_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Haptic feedback -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haptic feedback"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vibrate when toggling a task"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_haptic_feedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Auto Sync -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Sync"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-refresh on interval &amp; unlock; off shows a manual sync button"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_auto_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== SMART DAILY ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMART DAILY"
                android:textColor="@color/obsidian_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Smart Daily Tabs toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Daily tabs"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show Focus / Notes tab bar in widget"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_smart_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Smart Daily Capture toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Daily capture"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Route input under heading, not append"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/config_smart_capture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Create missing heading toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Create missing heading"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/config_create_missing_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:thumbTint="@color/obsidian_primary"
                        android:trackTint="@color/obsidian_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Task heading name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Task heading"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/config_task_heading"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:background="@drawable/input_background"
                        android:text="Fokus"
                        android:textColor="@color/obsidian_text"
                        android:textColorHint="@color/obsidian_text_secondary"
                        android:textSize="13sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:gravity="center"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Notes heading name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notes heading"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/config_notes_heading"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:background="@drawable/input_background"
                        android:text="Notes"
                        android:textColor="@color/obsidian_text"
                        android:textColorHint="@color/obsidian_text_secondary"
                        android:textSize="13sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:gravity="center"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Timestamp format -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Timestamp format"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/config_timestamp_format"
                        android:layout_width="100dp"
                        android:layout_height="36dp"
                        android:background="@drawable/input_background"
                        android:text="HH:mm"
                        android:textColor="@color/obsidian_text"
                        android:textColorHint="@color/obsidian_text_secondary"
                        android:textSize="13sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:gravity="center"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/obsidian_bg"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <!-- Default tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Default tab"
                        android:textColor="@color/obsidian_text"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/config_default_tab_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/config_default_tab_focus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Focus"
                            android:textColor="@color/obsidian_text"
                            android:textSize="12sp"
                            android:checked="true"
                            android:buttonTint="@color/obsidian_primary" />

                        <RadioButton
                            android:id="@+id/config_default_tab_notes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes"
                            android:textColor="@color/obsidian_text"
                            android:textSize="12sp"
                            android:buttonTint="@color/obsidian_primary" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== APPEARANCE ===== -->
            <TextView
                android:id="@+id/config_appearance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPEARANCE"
                android:textColor="@color/obsidian_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- Live theme / accent preview -->
            <LinearLayout
                android:id="@+id/config_theme_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/config_theme_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preview"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/config_theme_preview_swatch"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/config_theme_preview_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dark · Terracotta"
                            android:textColor="@color/obsidian_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/config_theme_preview_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accent applies to tabs, checkboxes, and buttons"
                            android:textColor="@color/obsidian_text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Theme -->
            <RadioGroup
                android:id="@+id/config_theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <RadioButton
                    android:id="@+id/config_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp"
                    android:buttonTint="@color/obsidian_primary" />

                <RadioButton
                    android:id="@+id/config_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Light"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp"
                    android:buttonTint="@color/obsidian_primary" />
            </RadioGroup>

            <!-- Accent Color -->
            <LinearLayout
                android:id="@+id/config_accent_color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/color_terracotta"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#D97757" />

                <View
                    android:id="@+id/color_purple"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#7C5FC7" />

                <View
                    android:id="@+id/color_blue"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#4A9EF5" />

                <View
                    android:id="@+id/color_green"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#4CAF50" />

                <View
                    android:id="@+id/color_red"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#E53935" />

                <View
                    android:id="@+id/color_teal"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#009688" />

                <View
                    android:id="@+id/color_pink"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:tag="#E91E63" />

                <View
                    android:id="@+id/color_amber"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:tag="#FFB300" />
            </LinearLayout>

            <!-- Opacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opacity"
                    android:textColor="@color/obsidian_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/config_transparency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="@color/obsidian_primary"
                    android:thumbTint="@color/obsidian_primary" />

                <TextView
                    android:id="@+id/config_transparency_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="100%"
                    android:textColor="@color/obsidian_text"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/config_save"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/button_background"
        android:text="@string/save_widget"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
